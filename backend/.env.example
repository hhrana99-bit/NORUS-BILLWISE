# NORUS BILLWISE Backend Environment Configuration Template
# Copy to .env for local development. Never commit real credentials or secrets.

APP_NAME=NORUS BILLWISE API
APP_ENV=development
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# PostgreSQL 16+ connection string (psycopg 3 driver)
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME_DEV_PASSWORD@localhost:5432/norus_billwise

# Secret key used to sign short-lived session access cookies (minimum 32 characters; replace before use)
JWT_SECRET_KEY=CHANGE_ME_REPLACE_WITH_32_PLUS_CHAR_RANDOM_SECRET

# Browser cookie transport security (must be true in staging and production over HTTPS)
COOKIE_SECURE=false

# Explicit comma-separated or JSON list of allowed frontend origins (never '*' with cookies)
CORS_ORIGINS=["http://localhost:3000"]

# Local filesystem path for uploaded invoice documents in development
DOCUMENT_STORAGE_ROOT=./var/documents
